---
import Layout from '../../layouts/Layout.astro';
import { getDoc } from '../../server/docService';
import { markdownToHtml } from '../../lib/markdown';

const { id } = Astro.params;

if (!id) {
	throw new Error('Document id is required.');
}

const doc = await getDoc(id);

if (!doc) {
	return new Response('Document not found.', { status: 404 });
}

const rendered = await markdownToHtml(doc.content);
---

<Layout title={`${doc.title} • copicat`}>
	<main class="doc-page">
		<header class="doc-page__header">
			<h1>{doc.title}</h1>
			<p>
				Created <time datetime={doc.createdAt}>{new Date(doc.createdAt).toLocaleString()}</time>
				· Updated <time datetime={doc.updatedAt}>{new Date(doc.updatedAt).toLocaleString()}</time>
			</p>
		</header>
		<article class="doc-page__content" set:html={rendered} />
	</main>
</Layout>

<script is:inline>
if (typeof window !== 'undefined') {
	const blocks = document.querySelectorAll('.doc-page__content pre');
	blocks.forEach((block) => {
		if (block.querySelector('.doc-page__copy')) {
			return;
		}
		block.classList.add('doc-page__code');
		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'doc-page__copy';
		button.setAttribute('aria-label', 'Copy code to clipboard');
		button.dataset.state = 'idle';
		button.innerHTML = '<span aria-hidden="true">⧉</span><span>Copy</span>';
		button.addEventListener('click', async () => {
			const codeElement = block.querySelector('code');
			const text = codeElement ? codeElement.innerText : block.textContent ?? '';
			try {
				await navigator.clipboard.writeText(text);
				button.dataset.state = 'copied';
				button.lastElementChild!.textContent = 'Copied!';
			} catch (error) {
				console.error('Failed to copy code snippet', error);
				button.dataset.state = 'error';
				button.lastElementChild!.textContent = 'Error';
			}
			setTimeout(() => {
				button.dataset.state = 'idle';
				button.lastElementChild!.textContent = 'Copy';
			}, 1600);
		});
		block.appendChild(button);
	});
}
</script>

<style>
	.doc-page {
		max-width: 70ch;
		margin: 0 auto;
		padding: 3rem 1.5rem 5rem;
		box-sizing: border-box;
		color: var(--color-text);
	}

	.doc-page__header h1 {
		margin-bottom: 0.5rem;
	}

	.doc-page__header p {
		margin: 0;
		color: var(--color-subtle);
		font-size: 0.95rem;
	}

	.doc-page__content {
		margin-top: 2rem;
		line-height: 1.7;
		display: grid;
		gap: 1.25rem;
		background: linear-gradient(145deg, hsla(222, 44%, 14%, 0.6), hsla(223, 36%, 18%, 0.45));
		padding: 2.5rem;
		border-radius: 1.25rem;
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-elevated);
	}

	.doc-page__code {
		position: relative;
		background: linear-gradient(135deg, hsla(222, 55%, 16%, 0.95), hsla(222, 45%, 11%, 0.95));
		color: var(--color-text);
		padding: 1.6rem 1.8rem 1.6rem;
		overflow-x: auto;
		border-radius: 0.95rem;
		border: 1px solid rgba(100, 116, 139, 0.35);
		box-shadow: 0 22px 55px rgba(8, 15, 40, 0.45);
		backdrop-filter: blur(6px);
	}

	.doc-page__code code {
		display: block;
		line-height: 1.65;
		font-size: 0.95rem;
		white-space: pre;
	}

	.doc-page__copy {
		position: absolute;
		top: 0.85rem;
		right: 0.85rem;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.35rem 0.75rem;
		border-radius: 999px;
		border: 1px solid rgba(148, 163, 184, 0.35);
		background: rgba(15, 23, 42, 0.78);
		color: var(--color-text);
		font-size: 0.75rem;
		font-weight: 600;
		cursor: pointer;
		opacity: 0;
		transform: translateY(-6px);
		transition: opacity 0.18s ease, transform 0.18s ease, background 0.18s ease, border-color 0.18s ease;
		pointer-events: none;
		z-index: 1;
	}

	.doc-page__code:hover .doc-page__copy,
	.doc-page__code:focus-within .doc-page__copy,
	.doc-page__copy:focus-visible {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
		outline: none;
	}

	.doc-page__copy span:first-child {
		font-size: 0.85rem;
	}

	.doc-page__copy[data-state='idle']:hover,
	.doc-page__copy[data-state='idle']:focus-visible {
		background: rgba(79, 70, 229, 0.25);
		border-color: rgba(129, 140, 248, 0.4);
	}

	.doc-page__copy[data-state='copied'] {
		background: rgba(34, 197, 94, 0.22);
		border-color: rgba(34, 197, 94, 0.45);
		color: #bbf7d0;
	}

	.doc-page__copy[data-state='error'] {
		background: rgba(248, 113, 113, 0.22);
		border-color: rgba(248, 113, 113, 0.45);
		color: #fecaca;
	}

	.doc-page__content code {
		font-family: 'Fira Code', Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace;
	}

	.doc-page__content h2,
	.doc-page__content h3,
	.doc-page__content h4 {
		margin-top: 1.75rem;
	}

	.doc-page__content a {
		color: var(--color-primary);
	}

	.doc-page__content blockquote {
		border-left: 4px solid var(--color-primary);
		padding-left: 1rem;
		color: var(--color-subtle);
		margin: 0;
	}

	.hljs {
		color: #e2e8f0;
		background: transparent;
	}

	.hljs-keyword,
	.hljs-selector-tag,
	.hljs-title,
	.hljs-section {
		color: #a5b4fc;
		font-weight: 600;
	}

	.hljs-literal,
	.hljs-number,
	.hljs-symbol,
	.hljs-bullet {
		color: #fbbf24;
	}

	.hljs-string,
	.hljs-doctag,
	.hljs-addition {
		color: #4ade80;
	}

	.hljs-comment,
	.hljs-quote {
		color: rgba(148, 163, 184, 0.75);
		font-style: italic;
	}

	.hljs-attr,
	.hljs-attribute,
	.hljs-name {
		color: #38bdf8;
	}

	.hljs-meta {
		color: #f472b6;
	}

	.hljs-emphasis {
		font-style: italic;
	}

	.hljs-strong {
		font-weight: 700;
	}
</style>
