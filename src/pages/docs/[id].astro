---
import Layout from "../../layouts/Layout.astro";
import { getDoc } from "../../server/docService";
import { markdownToHtml } from "../../lib/markdown";

const { id } = Astro.params;

if (!id) {
	throw new Error("Document id is required.");
}

const doc = await getDoc(id);

if (!doc) {
	return new Response("Document not found.", { status: 404 });
}

const rendered = await markdownToHtml(doc.content);
---

<Layout title={`${doc.title} • copicat`}>
	<main class="doc-page">
		<header class="doc-page__header">
			<h1>{doc.title}</h1>
			<p>
				Created <time datetime={doc.createdAt}
					>{new Date(doc.createdAt).toLocaleString()}</time
				>
				· Updated <time datetime={doc.updatedAt}
					>{new Date(doc.updatedAt).toLocaleString()}</time
				>
			</p>
		</header>
		<article class="doc-page__content" set:html={rendered} />
	</main>
</Layout>

<script is:inline>
	if (typeof window !== "undefined") {
		const blocks = document.querySelectorAll(".doc-page__content pre");
		blocks.forEach((block) => {
			if (block.querySelector(".doc-page__copy")) {
				return;
			}
			block.classList.add("doc-page__code");
			const button = document.createElement("button");
			button.type = "button";
			button.className = "doc-page__copy";
			button.setAttribute("aria-label", "Copy code to clipboard");
			button.dataset.state = "idle";
			button.innerHTML =
				'<span aria-hidden="true">📋</span><span>Copy</span>';
			button.addEventListener("click", async () => {
				const codeElement = block.querySelector("code");
				const text = codeElement
					? codeElement.textContent || codeElement.innerText
					: block.textContent || block.innerText || "";

				try {
					if (navigator.clipboard && navigator.clipboard.writeText) {
						await navigator.clipboard.writeText(text);
					} else {
						// Fallback for older browsers
						const textArea = document.createElement("textarea");
						textArea.value = text;
						textArea.style.position = "fixed";
						textArea.style.left = "-9999px";
						document.body.appendChild(textArea);
						textArea.focus();
						textArea.select();
						document.execCommand("copy");
						document.body.removeChild(textArea);
					}
					button.dataset.state = "copied";
					const textSpan = button.lastElementChild;
					if (textSpan) textSpan.textContent = "Copied!";
				} catch (error) {
					console.error("Failed to copy code snippet", error);
					button.dataset.state = "error";
					const textSpan = button.lastElementChild;
					if (textSpan) textSpan.textContent = "Error";
				}
				setTimeout(() => {
					button.dataset.state = "idle";
					const textSpan = button.lastElementChild;
					if (textSpan) textSpan.textContent = "Copy";
				}, 1600);
			});
			// Place the button at the top of the code block so it appears first
			block.prepend(button);
		});
	}
</script>

<style>
	.doc-page {
		/* Wider but still readable on large screens */
		max-width: clamp(72ch, 80vw, 100ch);
		width: 100%;
		margin: 0 auto;
		/* tighter, responsive padding (smaller top) */
		box-sizing: border-box;
		color: var(--color-text);
	}

	.doc-page__header h1 {
		margin-top: 1.5rem;
	}

	.doc-page__header h1 {
		margin-bottom: 0.5rem;
	}

	.doc-page__header p {
		margin: 0;
		color: var(--color-subtle);
		font-size: 0.95rem;
	}

	.doc-page__content {
		margin-top: 0.75rem;
		line-height: 1.7;
		display: grid;
		gap: 0.9rem;
		background: linear-gradient(
			145deg,
			hsla(222, 44%, 14%, 0.6),
			hsla(223, 36%, 18%, 0.45)
		);
		padding: clamp(1rem, 2vw, 1.5rem);
		border-radius: 1rem;
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-elevated);
	}

	:global(.doc-page__code) {
		position: relative;
		background: linear-gradient(
			135deg,
			hsla(222, 55%, 16%, 0.95),
			hsla(222, 45%, 11%, 0.95)
		);
		color: var(--color-text);
		/* extra top padding to make space for the copy button, but tighter sides */
		padding: 2rem 1.4rem 1.4rem;
		overflow-x: auto;
		border-radius: 0.95rem;
		border: 1px solid rgba(100, 116, 139, 0.35);
		box-shadow: 0 22px 55px rgba(8, 15, 40, 0.45);
		backdrop-filter: blur(6px);
	}

	:global(.doc-page__code code) {
		display: block;
		line-height: 1.65;
		font-size: 0.95rem;
		white-space: pre;
	}

	:global(.doc-page__copy) {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.4rem 0.8rem;
		border-radius: 6px;
		border: 1px solid rgba(148, 163, 184, 0.3);
		background: rgba(15, 23, 42, 0.85);
		backdrop-filter: blur(8px);
		color: var(--color-text);
		font-size: 0.8rem;
		font-weight: 500;
		cursor: pointer;
		opacity: 0;
		transform: translateY(-4px) scale(0.95);
		transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
		pointer-events: none;
		z-index: 1;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
	}

	:global(.doc-page__code:hover .doc-page__copy),
	:global(.doc-page__code:focus-within .doc-page__copy),
	:global(.doc-page__copy:focus-visible) {
		opacity: 1;
		transform: translateY(0) scale(1);
		pointer-events: auto;
		outline: none;
	}

	:global(.doc-page__copy span:first-child) {
		font-size: 0.9rem;
		line-height: 1;
	}

	:global(.doc-page__copy[data-state="idle"]:hover),
	:global(.doc-page__copy[data-state="idle"]:focus-visible) {
		background: rgba(79, 70, 229, 0.3);
		border-color: rgba(129, 140, 248, 0.5);
		transform: translateY(0) scale(1.02);
		box-shadow: 0 4px 12px rgba(79, 70, 229, 0.25);
	}

	:global(.doc-page__copy[data-state="copied"]) {
		background: rgba(34, 197, 94, 0.25);
		border-color: rgba(34, 197, 94, 0.5);
		color: #bbf7d0;
		box-shadow: 0 4px 12px rgba(34, 197, 94, 0.25);
	}

	:global(.doc-page__copy[data-state="error"]) {
		background: rgba(248, 113, 113, 0.25);
		border-color: rgba(248, 113, 113, 0.5);
		color: #fecaca;
		box-shadow: 0 4px 12px rgba(248, 113, 113, 0.25);
	}

	.doc-page__content code {
		font-family: "Fira Code", Menlo, Monaco, Consolas, "Liberation Mono",
			"Courier New", monospace;
	}

	.doc-page__content h2,
	.doc-page__content h3,
	.doc-page__content h4 {
		margin-top: 1.75rem;
	}

	.doc-page__content a {
		color: var(--color-primary);
	}

	.doc-page__content blockquote {
		border-left: 4px solid var(--color-primary);
		padding-left: 1rem;
		color: var(--color-subtle);
		margin: 0;
	}

	.hljs {
		color: #e2e8f0;
		background: transparent;
	}

	.hljs-keyword,
	.hljs-selector-tag,
	.hljs-title,
	.hljs-section {
		color: #a5b4fc;
		font-weight: 600;
	}

	.hljs-literal,
	.hljs-number,
	.hljs-symbol,
	.hljs-bullet {
		color: #fbbf24;
	}

	.hljs-string,
	.hljs-doctag,
	.hljs-addition {
		color: #4ade80;
	}

	.hljs-comment,
	.hljs-quote {
		color: rgba(148, 163, 184, 0.75);
		font-style: italic;
	}

	.hljs-attr,
	.hljs-attribute,
	.hljs-name {
		color: #38bdf8;
	}

	.hljs-meta {
		color: #f472b6;
	}

	.hljs-emphasis {
		font-style: italic;
	}

	.hljs-strong {
		font-weight: 700;
	}
</style>
