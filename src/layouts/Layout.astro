---
export interface Props {
	title: string;
}

const { title } = Astro.props as Props;

// Load syntax highlighting theme for code blocks
import "highlight.js/styles/github-dark.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
<style>
	:root {
		--font-size-base: clamp(1rem, 0.34vw + 0.91rem, 1.19rem);
		--font-size-lg: clamp(1.2rem, 0.7vw + 1.2rem, 1.5rem);
		--font-size-xl: clamp(2.44rem, 2.38vw + 1.85rem, 3.75rem);

		--color-text: hsl(210, 40%, 95%);
		--color-subtle: hsl(217, 24%, 72%);
		--color-bg: hsl(222, 47%, 11%);
		--color-surface: hsl(220, 43%, 14%);
		--color-border: hsla(215, 32%, 35%, 0.45);
		--color-primary: hsl(259, 95%, 68%);
		--shadow-elevated: 0 18px 60px rgba(15, 23, 42, 0.45);
	}

	html {
		color-scheme: dark;
		font-family: system-ui, sans-serif;
		font-size: var(--font-size-base);
		color: var(--color-text);
		background: radial-gradient(
				circle at top left,
				hsla(259, 65%, 45%, 0.25),
				transparent 55%
			),
			radial-gradient(
				circle at bottom right,
				hsla(193, 75%, 50%, 0.2),
				transparent 45%
			),
			var(--color-bg);
	}

	body {
		margin: 0;
		min-height: 100vh;
		background: transparent;
	}

	:global(h1) {
		font-size: var(--font-size-xl);
	}

	:global(h2) {
		font-size: var(--font-size-lg);
	}

	:global(code) {
		font-family:
			Menlo,
			Monaco,
			Lucida Console,
			Liberation Mono,
			DejaVu Sans Mono,
			Bitstream Vera Sans Mono,
			Courier New,
			monospace;
	}

	:global(pre) {
		background: var(--color-surface);
		padding: 1rem;
		border-radius: 0.5rem;
		overflow-x: auto;
	}

	:global(pre code) {
		background: transparent;
		padding: 0;
	}

	:global(p) {
		color: var(--color-subtle);
	}

	:global(a) {
		color: var(--color-primary);
		text-decoration: none;
	}

	:global(a:hover),
	:global(a:focus-visible) {
		color: hsl(259, 100%, 75%);
	}
</style>
